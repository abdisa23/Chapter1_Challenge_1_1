<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:id="transactionView"
      fx:controller="com.ethiopianbank.controllers.TransactionController"
      spacing="10" styleClass="content-pane">
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Transaction Management" styleClass="section-title" />
    </HBox>
    
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar">
        <DatePicker fx:id="fromDatePicker" promptText="From Date" />
        <DatePicker fx:id="toDatePicker" promptText="To Date" />
        <ComboBox fx:id="typeCombo" promptText="Transaction Type" />
        <TextField fx:id="accountField" promptText="Account Number" />
        <Button fx:id="filterButton" text="Filter" styleClass="primary-button" />
        <Button fx:id="clearButton" text="Clear" />
        <Button fx:id="exportButton" text="Export" />
    </HBox>
    
    <TableView fx:id="transactionTable" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" />
            <TableColumn fx:id="referenceColumn" text="Reference" prefWidth="150" />
            <TableColumn fx:id="accountColumn" text="Account" prefWidth="120" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100" />
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="100" />
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200" />
            <TableColumn fx:id="performedByColumn" text="Performed By" prefWidth="150" />
        </columns>
    </TableView>
    
    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" spacing="5" styleClass="card" prefWidth="200">
            <Label text="Total Deposits" styleClass="card-title" />
            <Label fx:id="totalDepositsLabel" text="ETB 0.00" styleClass="card-value" />
        </VBox>
        
        <VBox alignment="CENTER" spacing="5" styleClass="card" prefWidth="200">
            <Label text="Total Withdrawals" styleClass="card-title" />
            <Label fx:id="totalWithdrawalsLabel" text="ETB 0.00" styleClass="card-value" />
        </VBox>
        
        <VBox alignment="CENTER" spacing="5" styleClass="card" prefWidth="200">
            <Label text="Total Transfers" styleClass="card-title" />
            <Label fx:id="totalTransfersLabel" text="ETB 0.00" styleClass="card-value" />
        </VBox>
    </HBox>
    
</VBox>